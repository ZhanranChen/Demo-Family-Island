# Public — safe to expose to the browser (Supabase enforces access via
# Row Level Security, not by hiding these values).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build the magic-link redirect URL. Must also be added to
# Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_. Used solely inside server
# actions / route handlers that must bypass RLS (e.g. admin scripts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
